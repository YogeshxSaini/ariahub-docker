# Copy this file to .env and fill in the values below.
# Run ./setup.sh to generate secrets and directories automatically.

# --- Required secrets ---
# aria2 JSON-RPC secret. Generate with: openssl rand -hex 32
ARIA2_RPC_SECRET=

# API key required on every /api/* request except /api/health.
# Generate with: openssl rand -hex 32
# Leave empty ONLY for local/dev use with no public exposure.
API_KEY=

# --- Storage ---
# Host path where downloaded files are stored.
# Defaults to ./downloads if unset.
DOWNLOAD_PATH=./downloads

# --- Networking ---
# Host port the web UI is published on.
FRONTEND_PORT=8088

# Comma-separated list of allowed origins for the backend API, e.g.
# https://ariahub.example.com. Leave empty if the frontend and backend
# are always served from the same origin (the default nginx proxy setup).
CORS_ALLOW_ORIGINS=

# --- aria2 tuning (optional, sane defaults apply if left unset) ---
ARIA2_MAX_CONCURRENT_DOWNLOADS=5
ARIA2_SPLIT=8
ARIA2_MIN_SPLIT_SIZE=10M
ARIA2_MAX_CONNECTION_PER_SERVER=8

# --- Resource limits (optional) ---
ARIA2_CPU_LIMIT=2.0
ARIA2_MEM_LIMIT=1G
BACKEND_CPU_LIMIT=1.0
BACKEND_MEM_LIMIT=512M
FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEM_LIMIT=256M
